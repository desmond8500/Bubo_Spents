# Le navigateur doit toujours redemander ces fichiers au serveur, sinon il ne voit pas les nouvelles versions.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# Fichiers du build : leur nom change à chaque modification, ils peuvent être gardés indéfiniment.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
